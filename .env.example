# ─────────────────────────────────────────────────────────────────────────────
# The Love Legacy Masterclass funnel
#
# Copy this file to `.env.local` and fill in the real values. Everything here is
# NEXT_PUBLIC_ and inlined at build time, so a change needs a rebuild/redeploy
# to take effect.
# ─────────────────────────────────────────────────────────────────────────────

# ── Masterclass name ─────────────────────────────────────────────────────────
# The name of the event, everywhere it is said: page titles and social cards,
# the hero lockup, the comparison panel, the legal pages, the footer, the
# calendar invite and the Meta/GA event names.
#
# Only the EVENT. The Love Legacy Manifesto, the Love Legacy Visualization and
# the Private Love Legacy Community are separate products and keep their names.
NEXT_PUBLIC_MASTERCLASS_NAME="Stop Surviving. Start Designing."
# The brand sub-heading, shown wherever the masterclass name is shown: the hero
# lockup, the brand anchor under the hero, the OTO header, the final close and
# the footer. Two sentences; the site splits them onto two lines where needed.
# The event name is two sentences, so it cannot sit mid-clause. This is what
# prose uses instead ("By registering for the masterclass, you agree...").
NEXT_PUBLIC_MASTERCLASS_PROSE="the masterclass"
# ── Event date and time ──────────────────────────────────────────────────────
# The ONE variable that sets the event. Write it the way you would say it.
# Always read as IST. The weekday is worked out from the date automatically,
# so you never type "Sunday" and it can never disagree with the date.
#
#   "13 September 2026 at 8:00 PM"  ->  Sunday · Sunday, 13 September · 8:00 PM
#
# Also accepted: short months ("13 Sep 2026 at 8 PM") and 24-hour time
# ("13 September 2026 at 20:00").
NEXT_PUBLIC_WEBINAR_DATETIME="2 September 2026 at 11:30 PM"
NEXT_PUBLIC_WEBINAR_DURATION="90 minutes"
NEXT_PUBLIC_WEBINAR_SEATS="300"

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Two groups. Everyone who registers joins the masterclass group, which is where
# the Zoom link and reminders go. Buyers additionally get the private One Partner
# Reset community, shown only on /welcome-reset and /welcome-reset-plus.
# If a link is blank its button renders visibly disabled rather than dead.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=""

# TODO: paste the private One Partner Reset community invite link.
NEXT_PUBLIC_WHATSAPP_RESET_COMMUNITY_URL=""

# ── Prices (rupees, digits only) ─────────────────────────────────────────────
# COURSE   = The One Partner Reset, the OTO main offer
# VISUAL   = The Love Legacy Visualization, the add-on
# ANCHOR   = the struck-through price shown beside the live one
NEXT_PUBLIC_COURSE_PRICE="299"
NEXT_PUBLIC_VISUALIZATION_PRICE="199"
NEXT_PUBLIC_ANCHOR_PRICE="999"

# ── Checkout links ───────────────────────────────────────────────────────────
# Which link the OTO sends her to depends only on whether the add-on is kept.
# Both must point at a checkout that redirects to /welcome-reset on success.
NEXT_PUBLIC_OTO_LINK_PRODUCT_ONLY="https://coaching.sonalibadani.com/l/4d9bdfcd60"
NEXT_PUBLIC_OTO_LINK_PRODUCT_ADDON="https://coaching.sonalibadani.com/l/c8bde5394b"

# ── Pabbly webhooks ──────────────────────────────────────────────────────────
# NEW. Fires on every masterclass registration, the moment the form is
# submitted, for buyers and non-buyers alike.
NEXT_PUBLIC_PABBLY_REGISTRATION_WEBHOOK_URL=""

# EXISTING. Unchanged payload and behaviour. Fires only after a successful
# purchase, on /welcome-reset, where the checkout now returns buyers.
NEXT_PUBLIC_PABBLY_WEBHOOK_URL=""

# ── Tracking ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=""

# ── Bonus page lock ──────────────────────────────────────────────────────────
# The word that unlocks /bonus, where the three masterclass PDFs live.
#
# Sonali spells it out on the slides, one letter at a time, with the last letter
# arriving right at the end. That is the whole reason the page is locked, so give
# each cohort its own word if you want to.
#
# Letters and digits only. Case does not matter anywhere: this is normalised to
# capitals and the gate uppercases every keystroke. The number of input boxes and
# the copy that says "the four letter word" are both read off this value, so a
# five letter code renders five boxes and says "five" on its own.
NEXT_PUBLIC_BONUS_CODE="LOVE"

# ── Content flags ────────────────────────────────────────────────────────────
# Set to "false" to hide the empty testimonial slot briefs on the landing page
# until Sonali's approved client quotes are in. Leave unset while building so
# the team can see which slots still need filling.
NEXT_PUBLIC_SHOW_TESTIMONIAL_SLOTS="true"

# ── Meta Conversions API (server-side events) ────────────────────────────
# EVERY Meta event on this funnel except PageView fires server-side through
# /api/capi. NO NEXT_PUBLIC_ PREFIX: this is a secret and must never be inlined
# into a browser bundle. Generate it in Events Manager > Settings > Conversions
# API > Generate access token, for the SAME pixel as NEXT_PUBLIC_META_PIXEL_ID.
META_CAPI_ACCESS_TOKEN=

# Optional. Set to the code from Events Manager > Test Events while smoke
# testing, so events land in Test Events instead of production. CLEAR IT BEFORE
# GOING LIVE or no real conversion will ever be attributed.
META_CAPI_TEST_EVENT_CODE=

# Optional. Pin a different Graph API version. Defaults to v21.0.
META_GRAPH_API_VERSION=

# ── Production gate ──────────────────────────────────────────────────────
# Meta events and BOTH Pabbly webhooks fire only on these hosts. Everywhere
# else (localhost, every Vercel preview deployment) they are skipped, so a
# developer or a review build can never write a junk CRM row or teach the
# pixel a conversion that did not happen. Comma separated. Defaults to
# www.sonalibadani.com,sonalibadani.com when unset.
NEXT_PUBLIC_PRODUCTION_HOSTS="www.sonalibadani.com,sonalibadani.com"
